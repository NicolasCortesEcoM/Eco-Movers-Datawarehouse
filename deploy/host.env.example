# Host .env for the droplet deploy - copy to $APP_DIR/.env and fill from your
# laptop .env. The pipeline reads REPO_ROOT/.env (= $APP_DIR/.env). Never commit
# real secrets. On the HOST, Postgres is reached over localhost:5432 as
# platform_rw (no tunnel, no 172.18.0.1 - that gateway is only the Docker->host hop).

#  - - - - SmartMoving API (same keys as laptop .env)  - - - -
SMARTMOVING_API_KEY_LD=<from laptop .env>
SMARTMOVING_API_KEY_LOCAL=<from laptop .env>

#  - - - - Central store: droplet Postgres, reached locally on the host  - - - -
postgres_user=platform_rw
postgres_password=<droplet_platform_rw_password from laptop .env>
postgres_host=localhost
postgres_port=5432
postgres_db=datawarehouse

#  - - - - Droplet host access (see droplet_ssh_* in laptop .env)  - - - -
droplet_ssh_host=<droplet_ssh_host from laptop .env>
droplet_ssh_user=<droplet_ssh_user from laptop .env>
n8n_docker_gateway=<n8n_docker_gateway from laptop .env>

#  - - - - n8n webhook endpoints (see *_webhook_url in laptop .env)  - - - -
smartmoving_webhook_url=<smartmoving_webhook_url from laptop .env>
reporting_webhook_url=<reporting_webhook_url from laptop .env>
